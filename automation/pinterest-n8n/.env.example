# Copy to .env on the VPS and fill with real values.
# Never commit the real .env file.

POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=change-me-long-random-password

# Generate with: openssl rand -hex 32
# Keep this forever. Changing it will make stored n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-64-hex-chars

# Public VPS/domain settings.
# For direct IP access during setup, keep protocol http and host your server IP.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_PORT=5678
N8N_SECURE_COOKIE=false

# Your workflow itself uses Europe/Paris for trigger/posting slots.
GENERIC_TIMEZONE=Europe/Paris

# Optional execution retention controls.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=5000
