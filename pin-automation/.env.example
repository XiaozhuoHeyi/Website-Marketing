BUFFER_API_KEY=your_buffer_api_key
OPENAI_API_KEY=your_openai_api_key

# Put the whole Google service account JSON here for GitHub Actions/VPS env usage.
# Alternative for VPS: set GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

SPREADSHEET_ID=1ZGszsqsey9Pu08TrUMGq6gksatbHe2WNMLcw6fWV5BU
SHEET_NAME=Sheet1

OPENAI_MODEL=gpt-4.1-mini
POST_TIMEZONE=Europe/Paris
POST_HOURS=9,13,18
SLOTS_PER_RUN=3
DAYS_TO_QUEUE=1

# Default IDs are used only if the sheet row leaves the matching column blank.
DEFAULT_PINTEREST_CHANNEL_ID=658d2612c3b752215a86a80d
DEFAULT_FACEBOOK_CHANNEL_ID=658d296dc3b752215a9a9768
DEFAULT_INSTAGRAM_CHANNEL_ID=69fee6675c4c051afa286807
DEFAULT_PINTEREST_BOARD_SERVICE_ID=1113937357772186129

